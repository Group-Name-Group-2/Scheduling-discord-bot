# Copy this file to .env and fill in the values. .env is git-ignored.

# Required. Signs login session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Steam Web API key, from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=1CBBF9A7E8F3C82720175FD337A1D005

# Base URL used for links in emails (no trailing slash).
# Leave blank to use the URL of the incoming request.
APP_BASE_URL=http://localhost:8000

# Email (SMTP). Leave SMTP_HOST blank to print emails to the console instead of sending.
# For Gmail: smtp.gmail.com, port 587, and an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourname@gmail.com
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if blank.
EMAIL_FROM=Game Night <yourname@gmail.com>

# Set to 1 to enable test accounts / dev login. Remove before deploying.
DEV_LOGIN=1
